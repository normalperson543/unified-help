DATABASE_URL="" # change this to a valid Postgres database

SCRAPER_API_URL="http://localhost:4000" # point this to your scraper

FLARON_API_URL="https://flaron.halceon.dev" # Flaron API for resolving Slack mentions, channels, and emojis

NEXT_PUBLIC_SLACK_WORKSPACE_URL="https://hackclub.enterprise.slack.com" # used for mention and channel links

BETTER_AUTH_URL="http://localhost:3000" # point this to the URL unified help is running on
BETTER_AUTH_SECRET="" # generate this with https://better-auth.com/docs/installation

HACKCLUB_CLIENT_ID="" # get these from https://auth.hackclub.com
HACKCLUB_CLIENT_SECRET=""

SLACK_APP_TOKEN="" # get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=""

SENTRY_URL="" # points to a Sentry.io URL for error catching and performance logging
SENTRY_AUTH_TOKEN="" # find this in your Sentry organization settings
SENTRY_PROJECT_ORG="" #your sentry org name
SENTRY_PROJECT_NAME="" # your sentry project name

NEXT_PUBLIC_PLAUSIBLE_TRACKING_URL="https://plausible.io/js/pa-XXXXX.js" # this URL is given when you create a website on your Plausible instance
SCRAPER_API_KEY="" # this key will be shared between your scraper and Unified Help, generate with "openssl rand -hex 32"

OPENAI_API_KEY="" # required for AI-suggested replies
OPENAI_API_ENDPOINT="" # optional: custom OpenAI-compatible endpoint
OPENAI_MODEL="gpt-4o-mini" # chat model used to draft suggestions
OPENAI_EMBEDDING_MODEL="text-embedding-3-small" # optional: defaults to text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS="384" # optional: defaults to 384 (dimension returned by the Hack Club AI proxy)