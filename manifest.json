{
    "display_information": {
        "name": "UHSBot"
    },
    "features": {
        "bot_user": {
            "display_name": "UHSBot",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "groups:read",
                "channels:history",
                "usergroups:read",
                "users:read",
                "channels:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "request_url": "https://YOUR_SCRAPER_URL_HERE/slack/events",
            "bot_events": [
                "message.channels",
                "subteam_members_changed"
            ]
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}