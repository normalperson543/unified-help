// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          String      @id @unique @default(uuid())
  messageId   String
  program     Program     @relation(fields: [programId], references: [id])
  message     String
  dateCreated DateTime
  dateIndexed DateTime    @default(now())
  slackUser   SlackUser   @relation("ticketAuthor", fields: [slackUserId], references: [id])
  resolver    SlackUser?  @relation("ticketResolver", fields: [resolverId], references: [id])
  assignees   SlackUser[] @relation("ticketAssignees")
  status      Int         @default(0)

  programId   String
  slackUserId String
  resolverId  String?
  replies     Reply[]
}

model Program {
  id            String      @id @unique @default(uuid())
  name          String
  channelId     String
  tickets       Ticket[]
  assignedUsers SlackUser[]
  logo          String?
}

model SlackUser {
  id       String  @id @unique
  username String
  replies  Reply[]
  isBot    Boolean @default(false)

  programs        Program[]
  createdTickets  Ticket[]  @relation("ticketAuthor")
  resolvedTickets Ticket[]  @relation("ticketResolver")
  assignedTickets Ticket[]  @relation("ticketAssignees")
}

model Reply {
  id          String    @id @unique @default(uuid())
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  message     String
  messageId   String
  slackUser   SlackUser @relation(fields: [slackUserId], references: [id])
  slackUserId String
  dateCreated DateTime
  dateIndexed DateTime  @default(now())
  ticketId    String
}
