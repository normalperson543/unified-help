// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Ticket {
  id          String      @id @unique @default(uuid())
  messageId   String
  program     Program     @relation(fields: [programId], references: [id])
  message     String
  dateCreated DateTime
  dateIndexed DateTime    @default(now())
  slackUser   SlackUser   @relation("ticketAuthor", fields: [slackUserId], references: [id])
  resolver    SlackUser?  @relation("ticketResolver", fields: [resolverId], references: [id])
  assignees   SlackUser[] @relation("ticketAssignees")
  status      Int         @default(0)

  programId   String
  slackUserId String
  resolverId  String?
  replies     Reply[]
}

model Program {
  id              String      @id @unique @default(uuid())
  name            String
  channelId       String
  tickets         Ticket[]
  assignedUsers   SlackUser[]
  logo            String?
  usersOrganizing User[]      @relation("programsOrganizing")
}

model SlackUser {
  id       String  @id @unique
  username String
  replies  Reply[]
  isBot    Boolean @default(false)

  programs        Program[]
  createdTickets  Ticket[]  @relation("ticketAuthor")
  resolvedTickets Ticket[]  @relation("ticketResolver")
  assignedTickets Ticket[]  @relation("ticketAssignees")
  users           User[]
}

model Reply {
  id          String    @id @unique @default(uuid())
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  message     String
  messageId   String
  slackUser   SlackUser @relation(fields: [slackUserId], references: [id])
  slackUserId String
  dateCreated DateTime
  dateIndexed DateTime  @default(now())
  ticketId    String
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  slackId     String?
  slackUserId String?
  slackUser   SlackUser? @relation(fields: [slackUserId], references: [id])

  programsOrganizing Program[] @relation("programsOrganizing")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
